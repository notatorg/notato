{
    "manifest_version": 3,
    "name": "Notato",
    "version": "0.1.0",
    "description": "Pin notes to any web page and send them to your coding agent, with screenshots, the element, and where it is in your code. Works on any site you turn it on for.",
    "key": "",
    "minimum_chrome_version": "111",
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_title": "Notato",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon-16.png",
            "48": "icon-48.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": ["scripting", "storage"],
    "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
    "optional_host_permissions": ["http://*/*", "https://*/*"]
}
