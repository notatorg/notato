<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Notato.Maui.Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Notato.Maui.Sample.Views"
    Title="Notato sample">

    <TabBar>
        <ShellContent Title="Shop" Route="shop" ContentTemplate="{DataTemplate views:ProductsPage}" />
        <ShellContent Title="Account" Route="account" ContentTemplate="{DataTemplate views:AccountPage}" />
        <ShellContent Title="Feedback" Route="feedback" ContentTemplate="{DataTemplate views:FeedbackPage}" />
    </TabBar>

</Shell>
