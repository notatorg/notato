<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Notato.Maui.Sample.Models"
             x:Class="Notato.Maui.Sample.Views.ProductCard"
             x:DataType="models:Product">
    <Border Padding="14" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light=#e5e7eb, Dark=#374151}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1f2937}">
        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
            <Border x:Name="Swatch" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{Binding Color}">
                <Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="NameLabel" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding Tagline}" FontSize="13" TextColor="#9ca3af" LineBreakMode="TailTruncation" />
                <Label Text="{Binding StockText}" FontSize="12" TextColor="#d97706" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding PriceText}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
