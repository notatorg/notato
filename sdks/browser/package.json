{
    "name": "@notato/browser",
    "version": "0.3.1",
    "description": "Notato for any web page: the toolbar, element capture and screenshots, with no framework. @notato/react and the script tag are built on it.",
    "keywords": [
        "notato",
        "annotations",
        "feedback",
        "toolbar",
        "screenshots",
        "mcp",
        "coding-agent",
        "claude",
        "codex"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./env": "./src/env.ts"
    },
    "files": [
        "src"
    ],
    "dependencies": {
        "@noble/hashes": "^2.4.0",
        "@notato/core": "workspace:*",
        "@notato/schema": "workspace:*",
        "fflate": "^0.8.3",
        "modern-screenshot": "^4.7.0"
    },
    "devDependencies": {
        "fake-indexeddb": "^6.2.6",
        "happy-dom": "^21.0.4"
    }
}
