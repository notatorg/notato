    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src"
    ],
    "dependencies": {
        "@notato/browser": "workspace:*"
    },
    "peerDependencies": {
        "@angular/core": ">=19"
    },
    "devDependencies": {
        "@angular/core": "^22.2.0",
        "rxjs": "~7.8.0"
    }
}
