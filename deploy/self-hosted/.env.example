# Run `bun deploy/self-hosted/init.ts --admin-email you@example.com` to generate a private .env with random secrets.
# This file shows every setting. Copy it only if you prefer to write your own values.

# --- Which bundled services to run ------------------------------------------------------------------------------
# db = Postgres, storage = SeaweedFS (S3-compatible), mail = Mailpit (a mock inbox that sends nothing).
# Remove a profile to use your own instead, and set the matching settings below (see README.md).
COMPOSE_PROFILES=db,storage,mail

# --- The instance -------------------------------------------------------------------------------------------------
NOTATO_PUBLIC_URL=http://localhost:4799
NOTATO_HTTP_PORT=4799
NOTATO_MAIL_PORT=8026
NOTATO_ADMIN_EMAIL=admin@example.test
NOTATO_ADMIN_NAME=Instance administrator
NOTATO_ADMIN_PASSWORD=replace-with-a-unique-password
NOTATO_AUTH_SECRET=replace-with-at-least-32-random-characters
NOTATO_PLUGIN_KEY=replace-with-64-random-hex-characters
# closed (default), allowlist (needs NOTATO_SIGNUP_ALLOWED_EMAILS) or open.
NOTATO_SIGNUP_MODE=closed
# NOTATO_SIGNUP_ALLOWED_EMAILS=person@example.com
# Set to 1 only behind a reverse proxy you trust (see docs/reverse-proxy.md).
# NOTATO_TRUST_PROXY=1

# --- Database (bundled Postgres) --------------------------------------------------------------------------------
NOTATO_POSTGRES_PASSWORD=replace-with-a-unique-password
NOTATO_DATABASE_SSL=disable
# Your own Postgres instead (remove the db profile): see docs/external-postgres.md
# NOTATO_DATABASE_URL=postgres://notato:password@db.example.com:5432/notato
# NOTATO_DATABASE_SSL=verify-full
# NOTATO_DATABASE_CA_FILE=/certs/ca.pem

# --- Screenshot storage (bundled SeaweedFS) -----------------------------------------------------------------------
NOTATO_S3_ACCESS_KEY_ID=replace-with-a-unique-access-id
NOTATO_S3_SECRET_ACCESS_KEY=replace-with-a-unique-secret
NOTATO_S3_ENDPOINT=http://objects:8333
NOTATO_S3_FORCE_PATH_STYLE=true
# NOTATO_S3_BUCKET=screenshots
# NOTATO_S3_REGION=us-east-1
# Your own S3, R2, B2 or MinIO instead (remove the storage profile): see docs/object-storage.md

# --- Email (bundled Mailpit) --------------------------------------------------------------------------------------
NOTATO_SMTP_HOST=mailpit
NOTATO_SMTP_PORT=1025
NOTATO_EMAIL_FROM=notato@example.test
# Real email instead (remove the mail profile): see docs/email.md
# NOTATO_SMTP_HOST=smtp.example.com
# NOTATO_SMTP_PORT=587
# NOTATO_SMTP_SECURE=false
# NOTATO_SMTP_USER=...
# NOTATO_SMTP_PASSWORD=...
# NOTATO_EMAIL_FROM=Notato <notato@example.com>

# --- Optional -----------------------------------------------------------------------------------------------------
# Workspace capacity, independent of subscription plans:
# NOTATO_RESOURCE_LIMITS={"bytes":10737418240,"projects":1000}
# A published release instead of building from this checkout (use `up -d --no-build`):
# NOTATO_IMAGE=ghcr.io/notatorg/notato-server:0.3.0
