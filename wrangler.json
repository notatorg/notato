{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "notato-site",
    "compatibility_date": "2026-10-15",
    "workers_dev": false,
    "preview_urls": true,
    "routes": [{ "pattern": "notato.dev", "custom_domain": true }],
    "assets": {
        "directory": "./site/dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
    },
    "previews": {}
}
