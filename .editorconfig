# EditorConfig is awesome: https://EditorConfig.org
# C# rules live in sdks/dotnet/.editorconfig.

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# JavaScript, TypeScript, JSON, CSS
[*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}]
indent_style = space
indent_size = 4

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 4

# Swift, Kotlin and Gradle scripts
[*.{swift,kt,kts}]
indent_style = space
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefiles
[Makefile]
indent_style = tab
