{
    "name": "notato-monitor",
    "main": "src/worker.ts",
    "compatibility_date": "2026-10-15",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [],
    "triggers": {
        "crons": ["*/5 * * * *"]
    },
    "kv_namespaces": [
        {
            "binding": "MONITOR",
            "id": "REPLACE_WITH_YOUR_KV_NAMESPACE"
        }
    ],
    "vars": {
        "NOTATO_MONITOR_TARGET": "https://notato.example.com",
        "NOTATO_MONITOR_LABEL": "Notato",
        "NOTATO_MONITOR_INSTANCE": "notato",
        "NOTATO_ALERT_FROM": "Notato monitor <monitor@example.com>"
    },
    "observability": {
        "enabled": true
    }
}
