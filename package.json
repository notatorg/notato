{
    "name": "notato-monorepo",
    "version": "0.3.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "sdks/*",
        "sdks/react/example",
        "sdks/angular/example",
        "services/*"
    ],
    "scripts": {
        "build:schema": "bun run --filter @notato/schema build",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p sdks/react-native/tsconfig.json",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "bun run test:node && bun run test:bun",
        "test:node": "vitest run",
        "test:bun": "bun test packages/server packages/cli packages/board packages/extension scripts services",
        "check": "bun run lint && bun run typecheck && bun run test",
        "build:board": "bun run --filter @notato/board build",
        "build:extension": "bun run --filter @notato/extension build",
        "release:build": "bun run scripts/build-release.ts",
        "version": "bun scripts/version.ts",
        "build:site": "bun site/build.ts",
        "preview:site": "bun site/deploy-preview.ts",
        "deploy:site": "wrangler deploy",
        "site": "bun site/build.ts --serve",
        "build:service": "bun run --filter @notato/service-board build",
        "serve:service": "bun services/cli/src/main.ts serve",
        "test:service": "bun test services",
        "check:service": "bun run lint && bun run typecheck && bun run test:service && bun run build:service"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@notato/schema": "workspace:*",
        "@types/bun": "1.4.3",
        "ajv": "^8.20.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vite7": "npm:vite@^7.3.7",
        "vitest": "^5.0.5",
        "wrangler": "4.151.3"
    }
}
